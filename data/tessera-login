#!/bin/sh
# Called from ~/.profile on the first text screen (tty1). Starts the desktop
# and logs out of the text screen when the desktop ends, so a text prompt is
# never left open. If the desktop keeps failing to start, it stops retrying
# and explains how to get help instead of looping.

state="${XDG_STATE_HOME:-$HOME/.local/state}/tessera"
mkdir -p "$state"
failures_file="$state/start-failures"

started=$(date +%s)
tessera-session
status=$?
ran=$(( $(date +%s) - started ))

if [ "$status" -ne 0 ] && [ "$ran" -lt 20 ]; then
	failures=$(( $(cat "$failures_file" 2>/dev/null || echo 0) + 1 ))
	echo "$failures" > "$failures_file"
	if [ "$failures" -ge 3 ]; then
		echo "$(( failures - 3 ))" > "$failures_file"
		clear
		echo
		echo "  The Tessera desktop could not start."
		echo
		echo "  The details are in: $state/tessera.log"
		echo
		echo "  To log in on a text screen and fix it, press Ctrl + Alt + F2."
		echo "  It will try again in one minute."
		echo
		sleep 60
	else
		sleep 2
	fi
else
	rm -f "$failures_file"
fi
exit 0
