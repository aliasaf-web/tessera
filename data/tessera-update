#!/bin/sh
# Downloads the newest version of Tessera and installs it.

set -eu

src="$(cat "@PREFIX@/share/tessera/source" 2>/dev/null || true)"
if [ -z "$src" ] || [ ! -f "$src/install.sh" ]; then
	src="$HOME/tessera"
fi
if [ ! -f "$src/install.sh" ]; then
	echo "Could not find the Tessera folder (looked in $src)."
	exit 1
fi

cd "$src"
if [ -d .git ]; then
	printf '\n\033[1m==> Downloading the newest version\033[0m\n'
	if ! git pull --ff-only; then
		echo
		echo "Tessera could not be brought up to date: this folder has changes of"
		echo "its own, or it is on another branch, so nothing was installed."
		echo "Have a look, and ask someone to read this with you if it is unclear:"
		echo "    cd $src && git status -sb"
		exit 1
	fi
fi
exec sh ./install.sh --update
