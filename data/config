# Tessera settings for everyone on this computer.
# Use the Settings app to change these; it stores your choices in
# ~/.config/tessera/config, which overrides this file.
# This file is rewritten when Tessera is updated.
#
# Format (both files): one setting per line, written name=value. Spaces
# around the name and the value are ignored, and so are matching quotes
# around the value ("light" is the same as light). Lines starting with #
# are notes. A setting that appears twice uses its last value.

# Colours: dark or light. Highlight colour: orange, blue, teal, green,
# yellow, red, pink, purple, slate, or #rrggbb.
theme=dark
accent=orange

# Background: none, mosaic, or the path of a PNG picture.
wallpaper=none

# Bar and gaps: auto (compact on small screens), compact or comfortable.
layout_size=auto
# Space between windows in pixels; leave unset to follow layout_size. A gap
# separates windows from each other, so a window on its own gets the whole
# screen and the gap comes back with a second window. Set here, it means
# exactly this many pixels.
# gaps=14
animations=true

# Size of everything: auto, or 1, 1.25, 1.5, 1.75, 2. A screen's own size
# (below) comes first.
scale=auto

# Screens (Settings > Displays), each by the port it is plugged into; the
# command  tessera msg outputs  lists them. For example:
#   display.HDMI-A-1.enabled=true         (or false to switch it off)
#   display.HDMI-A-1.mode=1920x1080@60    (or auto; the @60 is optional)
#   display.HDMI-A-1.scale=1.25           (or auto)
#   display.HDMI-A-1.position=right       (left, above, below, mirror, auto, or X,Y)
# right, left, above and below are next to the built-in screen; mirror shows
# the same picture.

# Night light: off, scheduled or always.
night_light=off
night_light_from=20:00
night_light_to=07:00
night_light_temperature=4000

# Touchpad.
tap_to_click=true
natural_scroll=false
pointer_speed=0
gestures=true
swipe_direction=natural

# Keyboard. Empty means "use what was chosen when Debian was installed".
keyboard_layout=
keyboard_variant=
keyboard_options=

# Minutes of inactivity before the screen locks and then turns off (0 = never).
idle_lock_minutes=5
idle_screen_off_minutes=10

# Apps opened by Super+Enter, Super+E and Super+B.
terminal=foot
files=thunar
browser=x-www-browser
